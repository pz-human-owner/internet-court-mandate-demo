{
  "name": "internet-court-metamask-delegation",
  "version": "0.1.0",
  "private": true,
  "description": "Verdict-gated MetaMask Smart Accounts Kit (ERC-7710) delegation: pay the agent only when the GenLayer MandateVerdict jury says TRUE.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "simulate": "node scripts/simulate-fork.mjs --out sim-result.json",
    "plan": "node scripts/live.mjs plan",
    "test:contracts": "cd contracts && forge test && cd .. && node scripts/export-enforcer-artifact.mjs --check",
    "onchain:plan": "node scripts/onchain-check.mjs plan",
    "onchain:verify": "node scripts/onchain-check.mjs verify",
    "direct-proof": "npm --prefix ../genlayer-chain run plan --",
    "direct-proof:plan": "npm --prefix ../genlayer-chain run plan",
    "direct-proof:test": "npm --prefix ../genlayer-chain test",
    "direct-proof:dry-run": "npm --prefix ../genlayer-chain run dry-run"
  },
  "dependencies": {
    "@metamask/delegation-abis": "2.0.0",
    "@metamask/smart-accounts-kit": "2.0.0",
    "genlayer-js": "2.0.0-rc.3",
    "viem": "2.57.20"
  }
}
